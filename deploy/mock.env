# ===========================================================================
# mock 模式 env 模板（``deploy/compose.yaml`` 默认加载它；裁决 N7-a / §7.5 T6-d）
# ---------------------------------------------------------------------------
# - 本文件**不含任何密钥**（红线 #3）。mock 模式不发起任何真实付费调用。
# - 变量名**逐一取自** ``backend/app/config.py:Settings.from_env``（不凭记忆）。
# - ``DATABASE_URL`` / ``TEST_DATABASE_URL`` 由 ``compose.yaml`` 的 ``environment:``
#   以容器内服务名 postgres 覆盖，故此处**不**重复设置。
# ===========================================================================

# --- 模型选择（mock 模式的唯一依据：MODEL_PROVIDER == "mock"）---
MODEL_PROVIDER=mock
MODEL_CONFIG_ID=default
MODEL_NAME=mock-model
# mock 无需 endpoint / 密钥；留空即可。
MODEL_ENDPOINT=
# 若将来切到真实 provider，只在此填「存放 key 的环境变量名」，**不是** key 本体。
MODEL_API_KEY_ENV=SURVEY_MODEL_API_KEY

# --- 并发与超时（主文档 §5.3 / §7）---
# 100 = 并行执行槽位数（AGENT_CONCURRENCY），**不是**样本数/机器数/进程数。
AGENT_CONCURRENCY=100
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=256

# --- 限流（RPM/TPM；mock 不真正受限，但保留与真实一致的默认值）---
MODEL_RPM=3000
MODEL_TPM=3000000

# --- 价格 / 币种 ---
# 价格**留空（注释）**：无价格 ⇒ compute_cost 返回 None ⇒ attempts.actual_cost 落为
# SQL NULL（费用显示「未知」），符合项目硬规则「unknown 不得写成 0」。
# mock 返回的 input/output token 是**模拟值**，**不得**被当作真实计费对外表述（红线 #2）。
# MODEL_INPUT_PRICE_PER_MILLION=
# MODEL_OUTPUT_PRICE_PER_MILLION=
BUDGET_CURRENCY=CNY
