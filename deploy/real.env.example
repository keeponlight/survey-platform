# ===========================================================================
# 真实 provider env **模板**（裁决 N7-a）
# ---------------------------------------------------------------------------
# 用法：
#   cp deploy/real.env.example deploy/real.env     # 填入真实取值
#   docker compose -f deploy/compose.yaml -f deploy/compose.real.yaml up -d --build
#
# - 本文件是**模板**，只放占位符与环境变量名；**绝不**写入 key 的任何真实取值（红线 #3）。
# - 变量名**逐一取自** ``backend/app/config.py:Settings.from_env``（不凭记忆）。
# - ``deploy/real.env``（真实文件名）被 ``.gitignore`` 规则 ``*.env`` 忽略，**不会入库**。
# - 真实第三方 API 万人实测在本机**未执行**（无凭据），见 docs/runbook.md §4。
# ===========================================================================

# --- 模型选择（真实 provider 的唯一依据仍是 MODEL_PROVIDER，§7.5 T6-d）---
MODEL_PROVIDER=openai_compatible
MODEL_CONFIG_ID=<受控配置标识，例如 prod-openai>
MODEL_NAME=<模型名，例如 gpt-4o-mini>
MODEL_ENDPOINT=<OpenAI-compatible 基址，例如 https://api.example.com/v1>

# --- 密钥：此处只写「存放 key 的环境变量名」，**不是** key 本体 ---
# 真实 key 由部署环境注入，例如：export SURVEY_MODEL_API_KEY=...（不进代码/镜像/日志/快照）
MODEL_API_KEY_ENV=SURVEY_MODEL_API_KEY

# --- 并发与超时 ---
AGENT_CONCURRENCY=100
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=256

# --- 限流（填供应商实际配额）---
MODEL_RPM=<供应商 RPM 配额>
MODEL_TPM=<供应商 TPM 配额>

# --- 价格 / 币种 ---
# 留空（注释）= 费用显示「未知」，符合 unknown≠0；真实计费请取消注释并填单价。
# MODEL_INPUT_PRICE_PER_MILLION=1.0
# MODEL_OUTPUT_PRICE_PER_MILLION=2.0
BUDGET_CURRENCY=CNY
