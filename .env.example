# ===========================================================================
# 项目根 .env.example —— 本机开发模板（**不走 docker compose**；裁决 N7-a）
# ---------------------------------------------------------------------------
# 用法：``cp .env.example .env`` 后按需修改（``.env`` 被 .gitignore 忽略）。
# - 本文件**不含任何密钥**（红线 #3）；真实 key 只经部署环境变量注入。
# - 变量名**逐一取自** ``backend/app/config.py:Settings.from_env``（不凭记忆）。
# - 走 compose 请改用 ``deploy/mock.env`` / ``deploy/real.env``（见 deploy/）。
# ===========================================================================

# --- 数据库（本机 Docker 容器 survey-pg，127.0.0.1:55432）---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55432/survey
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55432/survey_test

# --- 并发（100 = 并行执行槽位数，不是样本数）---
AGENT_CONCURRENCY=100

# --- 模型（本机无真实 key → 默认 mock；唯一选择依据 = MODEL_PROVIDER）---
MODEL_PROVIDER=mock
MODEL_CONFIG_ID=default
MODEL_NAME=mock-model
MODEL_ENDPOINT=
# 只填「存放 key 的环境变量名」，**不是** key 本体。
MODEL_API_KEY_ENV=SURVEY_MODEL_API_KEY
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=256
MODEL_RPM=3000
MODEL_TPM=3000000

# --- 价格 / 币种 ---
# 价格留空（注释）：无价格 ⇒ 费用显示「未知」，符合 unknown≠0（不写成 0）。
# MODEL_INPUT_PRICE_PER_MILLION=
# MODEL_OUTPUT_PRICE_PER_MILLION=
BUDGET_CURRENCY=CNY
